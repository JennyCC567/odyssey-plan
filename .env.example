# LLM 服务商配置（服务端读取，不会暴露给浏览器）
# 支持 OpenAI 兼容接口：OpenRouter / Moonshot Kimi / 智谱 GLM 等
# 复制本文件为 .env.local 并填入真实 key；.env.local 已被 .gitignore 忽略，不会进仓库
OPENAI_API_KEY=
# 示例（OpenRouter）：https://openrouter.ai/api/v1
# 示例（Kimi 官方）：https://api.moonshot.cn/v1
OPENAI_BASE_URL=
# 示例（OpenRouter 上的 Kimi）：moonshotai/kimi-k3.1-pro
OPENAI_MODEL=

# 可选：Kimi K3.1 等思考模型关闭自定义采样参数（temperature 等只接受默认值时设为 off）
OPENAI_SAMPLING_PARAM=off
# 可选：思考强度（low 可显著降低思考 token 消耗与耗时）
OPENAI_REASONING_EFFORT=low

# 可选：单次 LLM 调用超时与输出 token 预算
PATHFINDER_LLM_TIMEOUT_MS=90000
