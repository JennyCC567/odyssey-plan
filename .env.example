# Zhipu GLM through its Anthropic-compatible endpoint.
# Copy this file to .env.local and fill in the key locally.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://open.bigmodel.cn/api/anthropic
OPENAI_MODEL=glm-5.3

# Optional overrides used by Pathfinder's server-side generation.
PATHFINDER_LLM_TIMEOUT_MS=45000
PATHFINDER_LLM_MAX_TOKENS=5200
